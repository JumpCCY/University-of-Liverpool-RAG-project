# Never commit real API keys.
.env

# the vector store is generated - rebuild it with py/embeddings/populate_vector_db.py.
# it was committed as ~50mb of binary index that changed on every run, which buried
# the real diffs in git status.
chroma_db/

# python bytecode
__pycache__/
*.pyc

# generated output and scratch reports. every .txt here is produced by a script or
# a test run - answer dumps, retrieval comparisons, prompt experiments - so they are
# ignored wholesale rather than listed one by one as they accumulate.
*.txt
# except this one, which is a kept copy of a prompt and is meant to be in history
!py/prompts_previous_general_answerer.txt
